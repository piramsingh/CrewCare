# Meta WhatsApp Business Cloud API — copy to .env and fill in.
# .env is gitignored. Never commit real values.

# Developer app → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0

# Any string you choose; paste the same one into Meta's callback config.
WHATSAPP_VERIFY_TOKEN=

# App Dashboard → Settings → Basic → App Secret.
# Without it, webhook signature verification is SKIPPED with a warning.
# Acceptable for a local demo; not acceptable for anything reachable.
WHATSAPP_APP_SECRET=

# Only needed if the freeform Q&A branch is enabled.
ANTHROPIC_API_KEY=
