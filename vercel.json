{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd crewcare && npm ci",
  "buildCommand": "cd crewcare && npm run build -- --base=/demo/ && cd .. && rm -rf .vercel-out && mkdir -p .vercel-out/demo && cp -R docs/. .vercel-out/ && cp -R crewcare/dist/. .vercel-out/demo/",
  "outputDirectory": ".vercel-out",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{admin_dashboard/**,crewcare/server/**}"
    }
  },
  "rewrites": [
    { "source": "/api/ops/:path*", "destination": "/api/index" }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)\\.(mp4|gif|jpg|png|svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
