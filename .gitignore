# Cached Open-Meteo responses. Re-fetched automatically when the TTL expires;
# three HTTP requests for the whole system, so never worth tracking.
admin_dashboard/admin_dashboard_model/.cache/

# Anonymous worker reports. Kept out of version control so real submissions
# never reach a public repo; the app reseeds illustrative demo records on
# first run of a fresh checkout.
admin_dashboard/admin_dashboard_model/complaints.json

.venv/
__pycache__/
*.pyc

# Runtime database for the WhatsApp service. It churns on every run and it
# accumulates employee-id-to-phone-number links, which is exactly the mapping
# the rest of the system is designed not to keep.
project/stationshield_whatsapp.db
.vercel
